#include <dt-bindings/zmk/matrix_transform.h>

#include <layouts/beekeeb/piantor/5column.dtsi>
#include <layouts/beekeeb/piantor/6column.dtsi>

&beekeeb_piantor_6col_layout {
    transform = <&default_transform>;
};

&beekeeb_piantor_5col_layout {
    transform = <&five_column_transform>;
};

&pico_serial {
    status = "okay";
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &beekeeb_piantor_6col_layout;
    };

    wired_split {
        compatible = "zmk,wired-split";
        device = <&pico_serial>;
    };

    // Each half is a direct-pin kscan of 21 keys, listed row by row from the
    // outer (pinky) column inwards, followed by the thumbs from outer to inner.
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <42>;
        rows = <1>;
        map = <
RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)    RC(0,26) RC(0,25) RC(0,24) RC(0,23) RC(0,22) RC(0,21)
RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11)   RC(0,32) RC(0,31) RC(0,30) RC(0,29) RC(0,28) RC(0,27)
RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16) RC(0,17)   RC(0,38) RC(0,37) RC(0,36) RC(0,35) RC(0,34) RC(0,33)
                           RC(0,18) RC(0,19) RC(0,20)   RC(0,41) RC(0,40) RC(0,39)
        >;
    };

    five_column_transform: keymap_transform_1 {
        compatible = "zmk,matrix-transform";
        columns = <42>;
        rows = <1>;
        map = <
RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)    RC(0,26) RC(0,25) RC(0,24) RC(0,23) RC(0,22)
RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11)   RC(0,32) RC(0,31) RC(0,30) RC(0,29) RC(0,28)
RC(0,13) RC(0,14) RC(0,15) RC(0,16) RC(0,17)   RC(0,38) RC(0,37) RC(0,36) RC(0,35) RC(0,34)
                  RC(0,18) RC(0,19) RC(0,20)   RC(0,41) RC(0,40) RC(0,39)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
    };
};
